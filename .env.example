# FitnessBuddy environment configuration
# Copy this file to .env and fill in your values

# ========== LLM API Keys ==========
# Anthropic runs the agent (Sonnet + Haiku); OpenAI is used for embeddings (RAG).
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-api-key

# ========== Server ==========
HOST=0.0.0.0
PORT=8080

# ========== Database ==========
# Default: SQLite (no setup needed)
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=/tmp/fitness_buddy_checkpoints.db

# ========== LangSmith (recommended) ==========
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=fitness_buddy

# ========== Supabase (section + plan persistence) ==========
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ========== Auth (optional) ==========
# AUTH_SECRET=your-secret-token
